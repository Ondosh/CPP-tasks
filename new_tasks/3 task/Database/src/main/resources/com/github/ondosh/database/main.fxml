<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0"
      prefWidth="800"
      prefHeight="600"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.ondosh.database.controller.MainController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Верхняя панель: кнопки + поиск + сортировка -->
    <VBox spacing="8.0">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Button text="Добавить" onAction="#onAddButton"/>
            <Button text="Изменить" onAction="#onEditButton"/>
            <Button text="Удалить"  onAction="#onDeleteButton"/>
            <Label text="Сортировать по:"/>
            <ComboBox fx:id="sortComboBox" onAction="#onSortChanged"/>
        </HBox>

        <!-- Строка поиска -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Поиск:"/>
            <TextField fx:id="searchField" promptText="Введите название..."
                       HBox.hgrow="ALWAYS" onKeyTyped="#onSearchChanged"/>
            <Button text="✕" onAction="#onSearchClear" prefWidth="30"/>
        </HBox>
    </VBox>

    <TableView fx:id="gamesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn"  text="Название"/>
            <TableColumn fx:id="genreColumn"  text="Жанр"/>
            <TableColumn fx:id="priceColumn"  text="Цена"/>
            <TableColumn fx:id="ratingColumn" text="Рейтинг"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="Готово"/>
</VBox>