<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="400" prefHeight="340"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.ondosh.database.controller.EditController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <Label text="Данные игры" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="4.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="70"/>
        </columnConstraints>

        <!-- Название -->
        <Label text="Название:" GridPane.rowIndex="0" GridPane.columnIndex="0"
               GridPane.valignment="TOP" style="-fx-padding: 4 0 0 0;"/>
        <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="2">
            <TextField fx:id="titleField"/>
            <Label fx:id="titleError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #e53935; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Жанр -->
        <Label text="Жанр:" GridPane.rowIndex="1" GridPane.columnIndex="0"
               GridPane.valignment="TOP" style="-fx-padding: 4 0 0 0;"/>
        <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" spacing="2">
            <TextField fx:id="genreField"/>
            <Label fx:id="genreError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #e53935; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Цена -->
        <Label text="Цена:" GridPane.rowIndex="2" GridPane.columnIndex="0"
               GridPane.valignment="TOP" style="-fx-padding: 4 0 0 0;"/>
        <VBox GridPane.rowIndex="2" GridPane.columnIndex="1" spacing="2">
            <TextField fx:id="priceField"/>
            <Label fx:id="priceError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #e53935; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Рейтинг -->
        <Label text="Рейтинг:" GridPane.rowIndex="3" GridPane.columnIndex="0"
               GridPane.valignment="TOP" style="-fx-padding: 4 0 0 0;"/>
        <VBox GridPane.rowIndex="3" GridPane.columnIndex="1" spacing="2">
            <TextField fx:id="ratingField"/>
            <Label fx:id="ratingError" text="" visible="false" managed="false"
                   style="-fx-text-fill: #e53935; -fx-font-size: 11px;"/>
        </VBox>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel" prefWidth="100"/>
        <Button text="Сохранить" onAction="#onSave" prefWidth="100"
                style="-fx-base: #4CAF50;"/>
    </HBox>
</VBox>