<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>

<!--
  Подключение стилей через stylesheets
  Путь к CSS файлу должен соответствовать структуре ресурсов
  styleClass - это стиль с определённым названием в css-файле
  stylesheets - это файл с списком и описанием стилей
  fx:controller - связывает разметку с контроллером.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.ondosh.chatbot.controller.ChatController"
      styleClass="chat-container"
      stylesheets="styles-chat-view.css">

    <!-- ListView для отображения истории сообщений чата -->
    <ListView fx:id="messageList"
              styleClass="message-list"
              VBox.vgrow="ALWAYS"/>

    <!-- Горизонтальная панель для поля ввода и кнопки отправки -->
    <HBox spacing="10">

        <!-- TextField для ввода пользовательского сообщения -->
        <TextField fx:id="inputField"
                   promptText="Введите сообщение..."
                   styleClass="input-field"
                   HBox.hgrow="ALWAYS"
                   onAction="#onSendMessage"/>

        <!-- Кнопка отправки сообщения -->
        <Button text="Отправить"
                styleClass="send-button"
                onAction="#onSendMessage"/>
    </HBox>

</VBox>