@startuml C4_Context

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title C4 Level 1 — Context: GigaChat Desktop Bot

Person(user, "Пользователь", "Вводит сообщения в окно чат-бота")

System(app, "Desktop Chat Bot", "GUI-приложение на Java.\nОбщается с пользователем,\nхранит историю и профиль.")

System_Ext(gigachat, "GigaChat API", "LLM от Сбера.\nГенерирует ответы на сообщения.")

System_Ext(fs, "Файловая система", "Хранит историю переписки\nи профили пользователей (JSON).")

Rel(user, app, "Вводит сообщения", "GUI (окно чата)")
Rel(app, user, "Отображает ответы", "GUI (окно чата)")
Rel(app, gigachat, "Запрашивает генерацию ответа", "REST API / HTTPS")
Rel(app, fs, "Читает и сохраняет", "Локальные файлы")

@enduml