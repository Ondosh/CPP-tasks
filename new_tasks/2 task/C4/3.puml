@startuml C4_Component_BotEngine

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Level 3 — Component: Bot Engine

Person(user, "Пользователь", "Вводит сообщения")

System_Ext(gigachat, "GigaChat API", "LLM от Сбера")

Container_Boundary(bot_engine, "Bot Engine") {

    Component(ibot, "IBot", "Java Interface", "Контракт для всех ботов.\nМетод: handle(User) → Message.")

    Component(hybrid, "HybridBot", "Java Class", "Композитный бот.\nВыбирает стратегию:\nGigaChat или Simple.")

    Component(giga, "GigaChatBot", "Java Class", "Вызывает GigaChat API.\nФормирует контекст из\nUserProfile и истории.")

    Component(simple, "SimpleBot", "Java Class", "Отвечает по шаблонам\nбез обращения к API.\nФоллбэк-стратегия.")

}

Container(gui, "GUI Layer", "JavaFX / Swing", "ChatController вызывает бота")
Container(model, "Domain Model", "Java", "User, Message, UserProfile")
Container(data, "Data & Util Layer", "Java", "HistoryManager, ProfileManager")

Rel(gui, hybrid, "Вызывает handle(User)", "Java call")
Rel(hybrid, ibot, "Реализует", "implements")
Rel(giga, ibot, "Реализует", "implements")
Rel(simple, ibot, "Реализует", "implements")

Rel(hybrid, giga, "Делегирует если есть профиль", "Java call")
Rel(hybrid, simple, "Делегирует как фоллбэк", "Java call")

Rel(giga, gigachat, "Запрашивает ответ", "REST API / HTTPS")
Rel(giga, model, "Читает UserProfile, User", "Java call")
Rel(giga, data, "Читает историю через HistoryManager", "Java call")

Rel(hybrid, model, "Передаёт User в дочерние боты", "Java call")

@enduml